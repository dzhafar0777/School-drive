    usecase "Ворид шудан ба система" as UC1

    usecase "Дидани маводи таълимӣ" as UC2
    usecase "Ҷустуҷӯи мавод" as UC3
    usecase "Боргирии мавод" as UC4

    usecase "Боркунии маводи таълимӣ" as UC5
    usecase "Идоракунии маводи худ" as UC6
    usecase "Идоракунии супоришҳо" as UC7

    usecase "Идоракунии истифодабарандагон" as UC8
    usecase "Идоракунии фанҳо" as UC9
    usecase "Идоракунии категорияҳо" as UC10
    usecase "Идоракунии иҷозатҳо" as UC11
    usecase "Назорати маводи таълимӣ" as UC12
